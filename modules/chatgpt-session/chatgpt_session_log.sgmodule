#!name=ChatGPT AccessToken 捕获（最小影响版）
#!desc=仅对 chatgpt.com 的 /api/auth/session 响应执行脚本，用于复制 accessToken；避免对 ChatGPT 其他请求挂载调试脚本。
#!system=ios

[MITM]
hostname = %APPEND% chatgpt.com

[Script]
ChatGPT_AccessToken_复制 = type=http-response,pattern=^https:\/\/chatgpt\.com\/api\/auth\/session(?:\?.*)?$,requires-body=true,max-size=262144,script-path=https://raw.githubusercontent.com/8310001/surge/main/modules/chatgpt-session/chatgpt_session_log.js,timeout=10,debug=true
