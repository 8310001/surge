#!name=ChatGPT Session 日志捕获
#!desc=访问 https://chatgpt.com/api/auth/session 时打印概要日志并发送通知；不保存完整返回、不复制 Token。
#!system=ios

[MITM]
hostname = %APPEND% chatgpt.com

[Script]
ChatGPT_Session_日志 = type=http-response,pattern=^https:\/\/chatgpt\.com\/api\/auth\/session,requires-body=true,max-size=1048576,script-path=https://raw.githubusercontent.com/8310001/surge/main/modules/chatgpt-session/chatgpt_session_log.js,timeout=10
